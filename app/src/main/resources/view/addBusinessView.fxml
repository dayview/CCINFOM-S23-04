<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.AddBusinessController"
      alignment="TOP_CENTER"
      prefHeight="600.0" prefWidth="600.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>
        <Label text="Add Business" style="-fx-font-size: 18; -fx-font-weight: bold;" />

        <!-- Business Name -->
        <HBox spacing="10">
            <Label text="Business Name:" prefWidth="150" />
            <TextField fx:id="businessNameField" prefWidth="300" />
        </HBox>

        <!-- Trade Name -->
        <HBox spacing="10">
            <Label text="Trade Name:" prefWidth="150" />
            <TextField fx:id="tradeNameField" prefWidth="300" />
        </HBox>

        <!-- Street Address -->
        <HBox spacing="10">
            <Label text="Street Address:" prefWidth="150" />
            <TextField fx:id="streetAddressField" prefWidth="300" />
        </HBox>

        <!-- Barangay -->
        <HBox spacing="10">
            <Label text="Barangay:" prefWidth="150" />
            <TextField fx:id="barangayField" prefWidth="300" />
        </HBox>
        <!-- Municipality ID -->
        <HBox spacing="10">
            <Label text="Municipality ID:" prefWidth="150" />
            <TextField fx:id="municipalityIdField" prefWidth="300" />
        </HBox>

        <!-- Business Type -->
        <HBox spacing="10">
            <Label text="Business Type:" prefWidth="150" />
            <TextField fx:id="businessTypeField" prefWidth="300" />
        </HBox>

        <!-- Tax ID -->
        <HBox spacing="10">
            <Label text="Tax ID:" prefWidth="150" />
            <TextField fx:id="taxIdField" prefWidth="300" />
        </HBox>

        <!-- Start Date -->
        <HBox spacing="10">
            <Label text="Start Date:" prefWidth="150" />
            <DatePicker fx:id="startDatePicker" prefWidth="300" />
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
            <Button fx:id="saveButton" text="Save" onAction="#onSave" prefWidth="100" />
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" prefWidth="100" />
        </HBox>
    </children>
</VBox>