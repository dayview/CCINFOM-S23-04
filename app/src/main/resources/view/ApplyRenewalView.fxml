<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="plainBG" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="635.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="businesspermitsystem.controllers.ApplyRenewalController">
   <children>
      <Rectangle fx:id="topHeader" arcHeight="5.0" arcWidth="5.0" fill="#046a38" height="108.0" stroke="#046a38" strokeType="INSIDE" width="635.0" />
      <Text fx:id="headerText" fill="WHITE" layoutX="140.0" layoutY="72.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Apply for Renewal">
         <font>
            <Font name="System Bold" size="45.0" />
         </font>
      </Text>
      
      <VBox layoutX="52.0" layoutY="147.0" prefHeight="520.0" prefWidth="531.0" spacing="15">
         <children>
            <!-- Business Selection -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Business:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <ComboBox fx:id="businessComboBox" prefWidth="380" promptText="Select Business" />
            </HBox>

            <!-- Permit Selection -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Permit:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <ComboBox fx:id="permitComboBox" prefWidth="380" promptText="Select Permit" />
            </HBox>

            <!-- Renewal Fee -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Renewal Fee:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <Label fx:id="renewalFeeLabel" text="₱0.00" textFill="#333333">
                  <font>
                     <Font name="Arial Bold" size="14.0" />
                  </font>
               </Label>
            </HBox>

            <!-- Surcharge -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Surcharge:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <Label fx:id="surchargeLabel" text="₱0.00" textFill="#333333">
                  <font>
                     <Font name="Arial Bold" size="14.0" />
                  </font>
               </Label>
            </HBox>

            <!-- Total Amount -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Total Amount:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <Label fx:id="totalAmountLabel" text="₱0.00" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="16.0" />
                  </font>
               </Label>
            </HBox>

            <!-- Details Area -->
            <VBox spacing="5">
               <Label text="Details:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <TextArea fx:id="detailsArea" editable="false" prefHeight="200" wrapText="true" />
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
               <Button fx:id="applyButton" onAction="#onApply" prefWidth="100" style="-fx-background-color: #046a38; -fx-text-fill: white; -fx-font-weight: bold;" text="Apply" />
               <Button fx:id="cancelButton" onAction="#onCancel" prefWidth="100" style="-fx-background-color: #cccccc; -fx-font-weight: bold;" text="Cancel" />
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>