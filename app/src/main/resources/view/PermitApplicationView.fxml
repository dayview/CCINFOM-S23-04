<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.PermitApplicationController"
      alignment="TOP_CENTER"
      prefHeight="600.0" prefWidth="600.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>

        <Label text="Initial Permit Issuance"
               style="-fx-font-size: 18; -fx-font-weight: bold;" />


        <HBox spacing="10">
            <Label text="Business:" prefWidth="150" />
            <Label fx:id="businessNameLabel" prefWidth="300" />
        </HBox>


        <HBox spacing="10">
            <Label text="Permit Type:" prefWidth="150" />
            <Label fx:id="permitTypeLabel" prefWidth="300" />
        </HBox>


        <HBox spacing="10">
            <Label text="Application Date:" prefWidth="150" />
            <DatePicker fx:id="applicationDatePicker" prefWidth="300" />
        </HBox>


        <HBox spacing="10">
            <Label text="Base Fee:" prefWidth="150" />
            <TextField fx:id="baseFeeField" prefWidth="300" editable="false" />
        </HBox>


        <HBox spacing="10">
            <Label text="Surcharge:" prefWidth="150" />
            <TextField fx:id="surchargeField" prefWidth="300" />
        </HBox>


        <HBox spacing="10">
            <Label text="Total Fee:" prefWidth="150" />
            <TextField fx:id="totalFeeField" prefWidth="300" editable="false" />
        </HBox>


        <HBox spacing="10">
            <Label text="Remarks:" prefWidth="150" />
            <TextArea fx:id="remarksArea" prefWidth="300" prefHeight="80" />
        </HBox>


        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
            <Button fx:id="backButton" text="Back" prefWidth="150" onAction="#handleBack" />
            <Button fx:id="submitButton" text="Submit Application" prefWidth="200" onAction="#handleSubmit" />
        </HBox>

    </children>
</VBox>
