<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane alignment="CENTER" hgap="10" vgap="15" prefHeight="400.0"
          prefWidth="600.0" styleClass="grid-pane"
          xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="businesspermitsystem.controllers.LoginController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Login To MySQL Server" styleClass="header-label"
           GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"
           GridPane.halignment="CENTER"/>

    <Label text="URL:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextField fx:id="urlField"
promptText="jdbc:mysql://localhost:3306/your_database"
               GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="350"/>

    <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <TextField fx:id="usernameField" promptText="Enter username"
               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <PasswordField fx:id="passwordField" promptText="Enter password"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="4">
          <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="25" prefHeight="25"/>
          <Button fx:id="connectButton" text="Connect" onAction="#handleConnect"
                  styleClass="primary-button" defaultButton="true"/>
          <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
                  styleClass="secondary-button" cancelButton="true"/>
    </HBox>

    <Label fx:id="statusLabel" GridPane.columnIndex="0" GridPane.rowIndex="5"
           GridPane.columnSpan="2" styleClass="status-label" wrapText="true"/>

</GridPane>