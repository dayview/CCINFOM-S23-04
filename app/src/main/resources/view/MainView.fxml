<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.MainController"
      alignment="TOP_CENTER"
      prefHeight="600.0" prefWidth="600.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>
        <Label text="Business Permit System" style="-fx-font-size: 18; -fx-font-weight: bold;" />

        <!-- Transaction Section -->
        <Label text="Transactions" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

        <Button fx:id="newBusinessRegistrationButton"
                text="New Business Registration and Initial Permit Issuance"
                onAction="#newBusinessRegistrationButtonPressed"
                prefWidth="400" />

        <Button fx:id="permitRenewalButton"
                text="Permit Renewal Transaction"
                onAction="#permitRenewalButtonPressed"
                prefWidth="400" />

        <Button fx:id="inspectionScheduleButton"
                text="Inspection Scheduling &amp; Clearance Transaction"
                onAction="#inspectionScheduleButtonPressed"
                prefWidth="400" />

        <Button fx:id="businessStatusUpdateButton"
                text="Business Status Update Transaction"
                onAction="#businessStatusUpdateButtonPressed"
                prefWidth="400" />

        <!-- Business Section -->
        <Label text="Business" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

        <Button fx:id="addBusinessButton"
                text="Add Business"
                onAction="#addBusinessButtonPressed"
                prefWidth="400" />

        <Button fx:id="updateBusinessButton"
                text="Update Business"
                onAction="#updateBusinessButtonPressed"
                prefWidth="400" />

        <Button fx:id="deleteBusinessButton"
                text="Delete Business"
                onAction="#removeBusinessButtonPressed"
                prefWidth="400" />

        <!-- Owner Section -->
        <Label text="Owner" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

        <Button fx:id="addOwnerButton"
                text="Add Owner"
                onAction="#addOwnerButtonPressed"
                prefWidth="400" />

        <Button fx:id="updateOwnerButton"
                text="Update Owner"
                onAction="#updateOwnerButtonPressed"
                prefWidth="400" />

        <Button fx:id="deleteOwnerButton"
                text="Delete Owner"
                onAction="#deleteOwnerButtonPressed"
                prefWidth="400" />

        <!-- Inspector Section -->
        <Label text="Inspector" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

        <Button fx:id="addInspectorButton"
                text="Add Inspector"
                onAction="#addInspectorButtonPressed"
                prefWidth="400" />

        <Button fx:id="updateInspectorButton"
                text="Update Inspector"
                onAction="#updateInspectorButtonPressed"
                prefWidth="400" />

        <Button fx:id="deleteInspectorButton"
                text="Delete Inspector"
                onAction="#deleteInspectorButtonPressed"
                prefWidth="400" />

        <!-- Municipality Section -->
        <Label text="Municipality" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

        <Button fx:id="addMunicipalityButton"
                text="Add Municipality"
                onAction="#addMunicipalityButtonPressed"
                prefWidth="400" />

        <Button fx:id="updateMunicipalityButton"
                text="Update Municipality"
                onAction="#updateMunicipalityButtonPressed"
                prefWidth="400" />

        <Button fx:id="deleteMunicipalityButton"
                text="Delete Municipality"
                onAction="#deleteMunicipalityButtonPressed"
                prefWidth="400" />
    </children>
</VBox>
