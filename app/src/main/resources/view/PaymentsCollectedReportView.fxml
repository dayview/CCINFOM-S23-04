<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.PaymentsCollectedReportController"
      alignment="TOP_CENTER"
      prefHeight="600.0" prefWidth="600.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>

        <Label text="Payments Collected Report"
               style="-fx-font-size: 18; -fx-font-weight: bold;" />
        <HBox spacing="10">
            <Label text="Enter Year:" prefWidth="150" />
            <TextField fx:id="yearField" promptText="e.g. 2025" prefWidth="150"/>
            <Button fx:id="generateReportButton"
                    text="Generate"
                    prefWidth="120"
                    onAction="#generateReport"/>
        </HBox>
        <HBox spacing="10">
            <Label text="" prefWidth="150" />
            <Button fx:id="exportButton"
                    text="Export to File"
                    prefWidth="150"
                    onAction="#exportToFile"/>
        </HBox>
        <TextArea fx:id="reportArea"
                  prefWidth="500" prefHeight="400"
                  wrapText="true"
                  editable="false"
                  style="-fx-padding: 10;"/>
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
            <Button fx:id="closeButton"
                    text="Close"
                    prefWidth="150"
                    onAction="#closeWindow"/>
        </HBox>
    </children>
</VBox>
