<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" prefWidth="450.0" prefHeight="350.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="businesspermitsystem.controllers.ScheduleInspectionController">
   
   
   <padding>
      <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
   </padding>

  
   <Label text="Create Inspection Schedule">
      <font>
         <Font name="System Bold" size="18.0" />
      </font>
   </Label>

 
   <GridPane hgap="10.0" vgap="15.0">
      <columnConstraints>
        
         <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="120.0" />
        
         <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
      </columnConstraints>
      
      
      <Label text="Select Business ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
      <ChoiceBox fx:id="businessIDChoiceBox" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" />

     
      <Label text="Business Details:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
      <VBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
         <Label fx:id="businessStatusLabel" text="Status: Pending" textFill="#666666" />
         <Label fx:id="businessMunicipalityLabel" text="Municipality: N/A" textFill="#666666" />
      </VBox>

     
      <Label text="Assign Inspector:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
      <ChoiceBox fx:id="inspectorIDChoiceBox" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />

      
      <Label text="Inspection Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
      <DatePicker fx:id="inspectionDatePicker" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
      
      <rowConstraints>
         <RowConstraints />
         <RowConstraints valignment="TOP" />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
   </GridPane>

   
   <Region VBox.vgrow="ALWAYS" />

  
   <HBox alignment="CENTER_RIGHT" spacing="10.0">
      <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancelButtonPressed" text="Cancel" />
      <Button fx:id="confirmButton" defaultButton="true" mnemonicParsing="false" onAction="#confirmButtonPressed" text="Confirm Schedule" />
   </HBox>
   
</VBox>