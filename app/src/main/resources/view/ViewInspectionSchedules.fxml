<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="businesspermitsystem.controllers.ViewInspectionSchedulesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   
    <Label text="Inspection Schedules" textFill="#333333">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
   </Label>
   
   <!-- FILTER BAR -->
   <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f0f0f0; -fx-padding: 10; -fx-background-radius: 5;">
      <children>
         <Label text="Filter By:" textFill="#666666">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         
         <VBox spacing="2.0">
            <Label font="$x1" text="From Date:" textFill="#888888">
               <font>
                  <Font size="10.0" fx:id="x1" />
               </font>
            </Label>
            <DatePicker fx:id="filterDateFrom" prefWidth="120.0" promptText="Start Date" />
         </VBox>
         
         <VBox spacing="2.0">
            <Label font="$x1" text="To Date:" textFill="#888888" />
            <DatePicker fx:id="filterDateTo" prefWidth="120.0" promptText="End Date" />
         </VBox>
         
         <VBox spacing="2.0">
            <Label font="$x1" text="Status:" textFill="#888888" />
            <ChoiceBox fx:id="filterStatusChoiceBox" prefWidth="120.0" />
         </VBox>

         <VBox spacing="2.0">
             <Label font="$x1" text="Business ID:" textFill="#888888" />
             <TextField fx:id="filterBusinessIdField" prefWidth="100.0" promptText="ID..." />
         </VBox>
         
         <Button mnemonicParsing="false" onAction="#resetFilters" text="Reset Filters" />
      </children>
   </HBox>

   <!-- TABLE VIEW -->
   <TableView fx:id="scheduleTable" prefHeight="400.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
     <columns>
       <TableColumn fx:id="colScheduleID" prefWidth="75.0" text="Sched ID" />
       <TableColumn fx:id="colBusinessID" prefWidth="100.0" text="Business ID" />
       <TableColumn fx:id="colInspectorID" prefWidth="100.0" text="Inspector ID" />
       <TableColumn fx:id="colDate" prefWidth="120.0" text="Inspection Date" />
       <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
     </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>
   
   <HBox alignment="CENTER_RIGHT" spacing="10.0">
      <children>
         <Button mnemonicParsing="false" onAction="#refreshTable" text="Refresh Data" />
         <Button mnemonicParsing="false" onAction="#closeWindow" text="Close" />
      </children>
   </HBox>
</VBox>
