<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="businesspermitsystem.controllers.OwnerSelectionController"
      alignment="CENTER"
      spacing="15"
      prefWidth="500"
      prefHeight="400"
      style="-fx-padding: 20;">

    <children>

        <Label text="Owner Selection"
               style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <Button text="Register New Owner"
                onAction="#handleNewOwner"
                prefWidth="250" />

        <Label text="OR Select Existing Owner"
               style="-fx-font-size: 16px;" />

        <ComboBox fx:id="OwnerDropDown"
                  prefWidth="300"
                  promptText="Select an Owner" />

        <Button text="Finish"
                onAction="#handleFinish"
                prefWidth="150" />

    </children>

</VBox>
