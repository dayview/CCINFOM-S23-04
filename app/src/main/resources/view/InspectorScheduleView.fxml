<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.InspectorScheduleController"
      alignment="TOP_CENTER"
      prefHeight="600.0" prefWidth="600.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>

        <!-- Title -->
        <Label text="Schedule Inspection"
               style="-fx-font-size: 18; -fx-font-weight: bold;" />

        <!-- Select Application -->
        <HBox spacing="10">
            <Label text="Select Application:" prefWidth="150" />
            <ComboBox fx:id="applicationComboBox" prefWidth="300" />
        </HBox>

        <!-- Select Inspector -->
        <HBox spacing="10">
            <Label text="Select Inspector:" prefWidth="150" />
            <ComboBox fx:id="inspectorComboBox" prefWidth="300" />
        </HBox>

        <!-- Select Inspection Date -->
        <HBox spacing="10">
            <Label text="Inspection Date:" prefWidth="150" />
            <DatePicker fx:id="inspectionDatePicker" prefWidth="300" />
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
            <Button fx:id="scheduleButton"
                    text="Schedule"
                    prefWidth="120"
                    onAction="#handleSchedule" />

            <Button fx:id="cancelButton"
                    text="Cancel"
                    prefWidth="120"
                    onAction="#handleCancel" />
        </HBox>

    </children>
</VBox>
