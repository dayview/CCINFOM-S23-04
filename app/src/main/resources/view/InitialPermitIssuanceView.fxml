<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.InitialPermitController"
      alignment="TOP_CENTER"
      prefHeight="600.0" prefWidth="600.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>

        <!-- TITLE -->
        <Label text="Initial Permit Issuance – Step 1"
               style="-fx-font-size: 18; -fx-font-weight: bold;" />

        <!-- SEARCH FIELD -->
        <HBox spacing="10">
            <Label text="Search Business:" prefWidth="150" />
            <TextField fx:id="searchField" prefWidth="300"
                       promptText="Type business name..." />
        </HBox>

        <!-- BUSINESS DROPDOWN -->
        <HBox spacing="10">
            <Label text="Select Business:" prefWidth="150" />
            <ComboBox fx:id="businessComboBox"
                      prefWidth="300" />
        </HBox>

        <!-- OWNER LIST -->
        <HBox spacing="10">
            <Label text="Owners Linked:" prefWidth="150" />
            <Label fx:id="ownerListLabel"
                   wrapText="true"
                   prefWidth="300" />
        </HBox>

        <!-- BUTTONS -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
            <Button fx:id="nextButton"
                    text="Next → Permit Type"
                    prefWidth="150"
                    disable="true"
                    onAction="#handleNext" />
            <Button fx:id="cancelButton"
                    text="Cancel"
                    prefWidth="150"
                    onAction="#handleCancel" />
        </HBox>

    </children>
</VBox>
