<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="businesspermitsystem.controllers.ComprehensiveComplianceReportController"
      spacing="15"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <HBox alignment="CENTER" style="-fx-padding: 10 0 10 0;">
        <Label text="Comprehensive Compliance Report"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </HBox>

    <Separator/>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="REPORT FILTERS" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="120"/>
                <ColumnConstraints minWidth="250" prefWidth="250" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Municipality:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="municipalityComboBox"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"
                      prefWidth="250" promptText="Select Municipality"/>

            <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                   style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="statusComboBox"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"
                      prefWidth="250" promptText="Select Status"/>

            <Label text="Start Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                   style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="startDatePicker"
                        GridPane.columnIndex="1" GridPane.rowIndex="2"
                        prefWidth="250"/>

            <Label text="End Date:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                   style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="endDatePicker"
                        GridPane.columnIndex="1" GridPane.rowIndex="3"
                        prefWidth="250"/>
        </GridPane>

        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="generateButton" text="Generate Report"
                    onAction="#generateReport"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20;"
                    prefWidth="180"/>
        </HBox>
    </VBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="SUMMARY STATISTICS" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

        <GridPane hgap="30" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0"
                  style="-fx-background-color: #3498db; -fx-background-radius: 5; -fx-padding: 15;">
                <Label text="Total Businesses" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                <Label fx:id="totalBusinessesLabel" text="0"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1"
                  style="-fx-background-color: #27ae60; -fx-background-radius: 5; -fx-padding: 15;">
                <Label text="Active Permits" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                <Label fx:id="activePermitsLabel" text="0"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2"
                  style="-fx-background-color: #e74c3c; -fx-background-radius: 5; -fx-padding: 15;">
                <Label text="Expired Permits" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                <Label fx:id="expiredPermitsLabel" text="0"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="3"
                  style="-fx-background-color: #f39c12; -fx-background-radius: 5; -fx-padding: 15;">
                <Label text="Compliance Rate" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                <Label fx:id="complianceRateLabel" text="0.00%"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
        </GridPane>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="DETAILED RECORDS" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

        <TableView fx:id="complianceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="businessIdColumn" text="Business ID" prefWidth="100"/>
                <TableColumn fx:id="businessNameColumn" text="Business Name" prefWidth="200"/>
                <TableColumn fx:id="ownerColumn" text="Owner" prefWidth="180"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                <TableColumn fx:id="activePermitsColumn" text="Active" prefWidth="80"/>
                <TableColumn fx:id="expiredPermitsColumn" text="Expired" prefWidth="80"/>
                <TableColumn fx:id="complianceColumn" text="Compliance" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
        <Label text="Export Format:" style="-fx-font-weight: bold;"/>
        <ChoiceBox fx:id="exportFormatChoiceBox" prefWidth="150"/>

        <Separator orientation="VERTICAL"/>

        <Button fx:id="exportButton" text="Export Report"
                onAction="#exportReport"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20;"
                prefWidth="150"/>

        <Button fx:id="backButton" text="Back to Main"
                onAction="#backToMain"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20;"
                prefWidth="150"/>
    </HBox>

</VBox>
