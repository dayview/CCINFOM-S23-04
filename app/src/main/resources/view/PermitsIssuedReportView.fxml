<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="businesspermitsystem.controllers.PermitsIssuedReportController" spacing="15" alignment="TOP_CENTER" style="-fx-padding: 20; -fx-background-color: #f4f7f9;">
    
    <Label text="Permits Issued Report" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" />
    
    <Separator />
    
    
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #e8eef2; -fx-padding: 10; -fx-border-radius: 5; -fx-background-radius: 5;">
        <Label text="Select Year:" style="-fx-font-weight: bold;" />
        <TextField fx:id="yearTextField" promptText="e.g., 2024" />
        <Button fx:id="generateReportButton" text="Generate Report" onAction="#generateReport" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Close" onAction="#closeReport" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
    </HBox>

    <Separator />

    
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-width: 1;">
        <content>
            <TextArea fx:id="reportTextArea" editable="false" wrapText="true" minHeight="500" style="-fx-font-family: 'Monospaced'; -fx-font-size: 14px; -fx-text-fill: #111;" />
        </content>
    </ScrollPane>

</VBox>