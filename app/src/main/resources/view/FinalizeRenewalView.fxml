<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.*?> 

<AnchorPane fx:id="plainBG" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="635.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="businesspermitsystem.controllers.FinalizeRenewalController">
   <children>
      <Rectangle fx:id="topHeader" arcHeight="5.0" arcWidth="5.0" fill="#046a38" height="108.0" stroke="#046a38" strokeType="INSIDE" width="635.0" />
      <Text fx:id="headerText" fill="WHITE" layoutX="130.0" layoutY="72.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Finalize Renewal">
         <font>
            <Font name="System Bold" size="45.0" />
         </font>
      </Text>
      
      <VBox layoutX="52.0" layoutY="147.0" prefHeight="470.0" prefWidth="531.0" spacing="15">
         <children>
            <!-- Renewal Selection -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Renewal ID:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <ComboBox fx:id="renewalComboBox" prefWidth="380" promptText="Select Renewal" />
            </HBox>

            <!-- Schedule Selection -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Schedule:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <ComboBox fx:id="scheduleComboBox" prefWidth="380" promptText="Select Schedule" />
            </HBox>

            <!-- Result -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label prefWidth="150" text="Result:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <ComboBox fx:id="resultComboBox" prefWidth="200" promptText="Select result" />
            </HBox>

            <!-- Remarks -->
            <VBox spacing="5">
               <Label text="Remarks:" textFill="#046a38">
                  <font>
                     <Font name="Arial Black" size="14.0" />
                  </font>
               </Label>
               <TextArea fx:id="remarksArea" prefHeight="200" wrapText="true" promptText="Enter remarks..." />
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
               <Button fx:id="finalizeButton" onAction="#onFinalize" prefWidth="100" style="-fx-background-color: #046a38; -fx-text-fill: white; -fx-font-weight: bold;" text="Finalize" />
               <Button fx:id="cancelButton" onAction="#onCancel" prefWidth="100" style="-fx-background-color: #cccccc; -fx-font-weight: bold;" text="Cancel" />
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>