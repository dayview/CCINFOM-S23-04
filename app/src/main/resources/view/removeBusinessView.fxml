<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Alert?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      prefHeight="300.0" prefWidth="400.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.RemoveBusinessController">

    <children>

        <!-- Header -->
        <Label alignment="CENTER"
               text="Remove Business"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               textAlignment="CENTER">
            <VBox.margin>
                <Insets top="20.0" bottom="20.0"/>
            </VBox.margin>
        </Label>

        <!-- Business ID Input -->
        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="350.0">
            <children>
                <Label text="Business ID" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="10.0" right="10.0"/>
                    </HBox.margin>
                </Label>
                <TextField fx:id="businessIdField"
                           promptText="Enter Business ID to remove"
                           HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="10.0" prefHeight="40.0" prefWidth="300.0">
            <children>
                <Button fx:id="removeButton"
                        text="Remove"
                        onAction="#handleRemoveBusiness"
                        style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="cancelButton"
                        text="Cancel"
                        onAction="#handleCancel"
                        style="-fx-background-color: #b0bec5; -fx-text-fill: black;"/>
            </children>
        </HBox>

    </children>

    <padding>
        <Insets left="20.0" right="20.0" top="10.0" bottom="10.0"/>
    </padding>

</VBox>
