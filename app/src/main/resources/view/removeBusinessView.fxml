<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="businesspermitsystem.controllers.RemoveBusinessController"
      alignment="TOP_CENTER"
      prefHeight="300.0" prefWidth="400.0"
      spacing="10"
      style="-fx-padding: 20;">

    <children>

        <!-- Header -->
        <Label text="Remove Business"
               style="-fx-font-size: 18; -fx-font-weight: bold;" />

        <!-- Business ID -->
        <HBox spacing="10">
            <Label text="Business ID:" prefWidth="150" />
            <TextField fx:id="businessIdField"
                       prefWidth="200"
                       promptText="Enter ID to remove" />
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
            <Button fx:id="removeButton"
                    text="Remove"
                    onAction="#handleRemoveBusiness"
                    prefWidth="100"
                    style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;" />

            <Button fx:id="cancelButton"
                    text="Cancel"
                    onAction="#handleCancel"
                    prefWidth="100"
                    style="-fx-background-color: #b0bec5; -fx-text-fill: black;" />
        </HBox>

    </children>

</VBox>
